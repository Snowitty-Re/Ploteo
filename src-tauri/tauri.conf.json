{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ploteo",
  "version": "0.1.0",
  "identifier": "com.ploteo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ploteo",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
